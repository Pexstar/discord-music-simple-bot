# Discord Bot Token (Dapatkan dari Discord Developer Portal)
DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN_HERE"

# Client ID dari Bot Anda
CLIENT_ID="YOUR_BOT_CLIENT_ID_HERE"

# (Opsional) Guild ID untuk testing command agar langsung terupdate
# Jika diisi, command hanya akan berjalan di server ini.
# Jika dikosongkan, command akan bersifat Global (bisa dipakai di server mana saja, tapi butuh waktu hingga 1 jam untuk update).
GUILD_ID="YOUR_GUILD_ID_HERE"
